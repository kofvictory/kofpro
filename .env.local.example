NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# AIアシスタント (コフ) — いずれか一方を設定
# ローカル推論 (Ollama): ollama run <model> を起動するだけで自動検出
# タスク連動(ツール使用)を使うなら tool calling 対応モデルを推奨:
#   例) qwen2.5  /  llama3.1  (phi4-mini はツール使用が不安定)
OLLAMA_MODEL=qwen2.5

# 接続先 (既定: Ollama)。OpenAI/Ollama互換サーバーなら何でも指定可。
# Snapdragon X の NPU を使う npurun に切り替える場合は 11435 を指定:
#   OLLAMA_HOST=http://localhost:11435
# OLLAMA_HOST=http://localhost:11434

# クラウドフォールバック / 「賢いモード」(Claude) に使用
ANTHROPIC_API_KEY=your-anthropic-api-key
